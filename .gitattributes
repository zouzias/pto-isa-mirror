# Keep repository text files portable across Linux CI and Windows worktrees.
* text=auto eol=lf

# Files executed or parsed by Linux CI must never be checked out with CRLF.
*.sh text eol=lf
*.bash text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.py text eol=lf
*.cpp text eol=lf
*.cc text eol=lf
*.c text eol=lf
*.hpp text eol=lf
*.h text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.txt text eol=lf

# Preserve binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.svg text eol=lf
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.run binary
