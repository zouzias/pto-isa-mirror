+        sum_repeat_times = 0;
+        using T = typename TileDataDst::DType;
+        runBinaryOp<T, Op, TileDataDst, TileDataSrc0, TileDataSrc1>(dst, src0, src1);
+        float resultCycles = PredictCycle<T>(instr_name);
+        dst.SetCycle(resultCycles);
