+    # 1. Try Clang
+    cxx, cc = _try_find_compiler("clang++", "clang", 15)
+    if cxx:
+        return cxx, cc
+
+    # 2. Try GCC
+    cxx, cc = _try_find_compiler("g++", "gcc", 13)
+    if cxx:
+        return cxx, cc
+
+    # 3. Fail
+    error_msg = (
+        "Could not find a suitable compiler.\n"
+        "Requirements:\n"
+        " - clang++ >= 15\n"
+        " - OR g++ >= 13"
+    )
+    logging.error(error_msg)
