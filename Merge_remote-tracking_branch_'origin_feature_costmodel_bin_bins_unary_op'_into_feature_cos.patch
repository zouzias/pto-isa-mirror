+def _print_if_pattern(completed, patterns):
+    for line in (completed.stdout or "").splitlines():
+        if any(p.search(line) for p in patterns):
+            logging.info(line.rstrip())
+    for line in (completed.stderr or "").splitlines():
+        if any(p.search(line) for p in patterns):
+            logging.info(line.rstrip())
