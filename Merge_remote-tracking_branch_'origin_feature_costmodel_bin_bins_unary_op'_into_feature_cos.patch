+    unsigned numElements = validRow * validCol;
+    unsigned headRepeats = numElements / elementsPerRepeat;
+    unsigned tailElements = numElements % elementsPerRepeat;
+    Op::BinInstr(headRepeats); // headRepeats can be zero
+    if (tailElements)
+        [[unlikely]]
+        {
+            Op::BinInstr(1);
+        }
